# Database connection for Prisma (Neon — use your project's pooled connection string)
DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Auth (Better Auth)
BETTER_AUTH_SECRET="super-secret-string-replace-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Xendit
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# All-Access package price, in IDR (optional - defaults to 500000 if unset)
ALL_ACCESS_PRICE_IDR=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONSULTATION_NOTIFY_EMAIL="sales@kelas.ai"

# S3 (AWS/Cloudflare R2)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION=""
S3_ENDPOINT=""

# Cron (Vercel Cron calls /api/cron/nudges with this as a bearer token)
CRON_SECRET="super-secret-string-replace-me"
