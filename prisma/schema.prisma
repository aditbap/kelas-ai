generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Student
  Editor
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  passwordHash  String?
  role          Role
  lastNudgedAt  DateTime? // Phase 12 habit-loop: last post-training nudge email sent, to cap cadence
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  cohortMemberships CohortMember[]
  submissions       Submission[]
  sessionProgress   SessionProgress[]
  createdModules    Module[]
  gradedSubmissions Grade[]
  cohortsCreated    Cohort[]
  auditLogs         AuditLog[]
  payments          Payment[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// A Cohort is purely an onsite-session/community grouping (a schedulable
/// batch with a lead Editor and a roster) - it carries no price and gates no
/// content. Module access is governed platform-wide by Payment (the single
/// All-Access package), not by cohort membership.
model Cohort {
  id         String   @id @default(uuid())
  name       String
  onsiteDate DateTime
  editorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  editor  User           @relation(fields: [editorId], references: [id], onDelete: Restrict)
  members CohortMember[]
}

model CohortMember {
  id        String   @id @default(uuid())
  cohortId  String
  userId    String
  createdAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
}

model Module {
  id                   String   @id @default(uuid())
  title                String
  description          String?
  createdByEditorId    String
  // Nullable self-relation: a module can require another module of the same
  // editor's to be fully completed first (e.g. Modul 2 requires Modul 1).
  // SetNull rather than Restrict/Cascade, so deleting the prerequisite just
  // unlocks the dependent module instead of blocking the deletion or cascading.
  prerequisiteModuleId String?
  // A draft module is only visible to its Editor. Publishing makes it visible
  // platform-wide to every Student holding the single All-Access package -
  // there is no per-cohort publication step anymore.
  isPublished          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  createdBy    User            @relation(fields: [createdByEditorId], references: [id], onDelete: Restrict)
  prerequisite Module?         @relation("ModulePrerequisite", fields: [prerequisiteModuleId], references: [id], onDelete: SetNull)
  unlocks      Module[]        @relation("ModulePrerequisite")
  sessions     ModuleSession[]
}

/// A module is broken into ordered sessions (e.g. "Sesi 1: Fondasi Prompting").
/// A single-session module (like Modul 1) just has one row here. Publishing,
/// prerequisites, and cohort access all stay at the Module level; sessions are
/// purely a content-and-progress grouping underneath it.
model ModuleSession {
  id        String   @id @default(uuid())
  moduleId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]
  progress    SessionProgress[]

  @@unique([moduleId, order])
}

enum ContentType {
  Text
  Video
  File
}

/// What role a content block plays within its session, so the UI can render
/// "Tujuan Belajar" / "Ringkasan Konsep" / "Instruksi Praktik" as distinct,
/// labeled sections instead of an undifferentiated list.
enum LessonKind {
  Objectives
  Summary
  Practice
  Supplementary
}

model Lesson {
  id          String      @id @default(uuid())
  sessionId   String
  title       String
  contentType ContentType
  kind        LessonKind  @default(Supplementary)
  content     String? // Text content or URL
  order       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  session ModuleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum SubmissionType {
  File
  Text
  Link
}

model Assignment {
  id                 String         @id @default(uuid())
  sessionId          String
  instructions       String
  submissionType     SubmissionType
  dueDate            DateTime?
  // Flags a task whose output (e.g. a notification or auto-reply template) is
  // meant to be reused as-is in a later automation module, so it can be
  // queried and surfaced without re-deriving it from instruction text.
  isAdvancedMaterial Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  session     ModuleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

enum SubmissionStatus {
  Pending
  Graded
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  userId       String
  content      String? // File URL or Text or Link
  status       SubmissionStatus @default(Pending)
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade      Grade?

  @@unique([assignmentId, userId])
}

model Grade {
  id               String   @id @default(uuid())
  submissionId     String   @unique
  gradedByEditorId String
  score            Int? // Optional numeric score
  passFail         Boolean? // Optional pass/fail
  feedbackText     String?
  gradedAt         DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User       @relation(fields: [gradedByEditorId], references: [id], onDelete: Restrict)
}

enum AssignmentStatus {
  NotStarted
  Pending
  Graded
}

/// Progress is tracked per session, not per module, so a student can resume
/// from the last session they actually worked on within a multi-session
/// module instead of the app only knowing "some lesson in this module".
model SessionProgress {
  id                    String           @id @default(uuid())
  userId                String
  sessionId             String
  lessonsCompletedCount Int              @default(0)
  assignmentStatus      AssignmentStatus @default(NotStarted)
  lastActivityAt        DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ModuleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

enum ResourceType {
  Tip
  Template
  Guide
}

model ResourceItem {
  id        String       @id @default(uuid())
  type      ResourceType
  title     String
  content   String
  tags      String[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum PaymentStatus {
  Paid
  Open
  Void
  Uncollectible
}

/// The single All-Access package purchase: one Student ever has at most one
/// row here (@@unique([studentId])), bought once via Xendit, and it
/// permanently unlocks every published Module platform-wide. There is no
/// recurring billing and no per-cohort or per-module pricing.
model Payment {
  id              String        @id @default(uuid())
  studentId       String        @unique
  amount          Int // In the invoice's currency's base unit (e.g. Rupiah for IDR), after any promo discount
  status          PaymentStatus @default(Paid)
  xenditInvoiceId String?       @unique
  promoCode       String? // Set when a promo code (e.g. a 100%-off code) was applied at checkout
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

/// Discrete Editor actions worth an audit trail (content authoring, grading,
/// enrollment payments) - not a request log, just state-changing actions.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  // Restrict, not Cascade: deleting a user must never silently erase the audit
  // trail they produced - that defeats the point of an audit log. A future
  // user-deletion flow has to explicitly decide what happens to their history.
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
}
