# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# This file is scoped to what this project actually uses (npm, Next.js, Prisma/Neon,
# TypeScript, Vitest, ESLint/Prettier/Husky) — no boilerplate for tooling we don't run.

# ---- dependencies ----
/node_modules

# ---- next.js build output ----
/.next/
/out/

# ---- production build ----
/build

# ---- testing / coverage ----
/coverage
/.vitest-cache

# ---- typescript / prisma generated output ----
# Both are regenerated from source (tsc / `prisma generate`) — never hand-edited,
# so committing them would just be dead weight that drifts from schema.prisma.
*.tsbuildinfo
next-env.d.ts
/src/generated/prisma

# NOTE: prisma/migrations/ is intentionally NOT ignored — those files are the
# source of truth for schema history and must be committed and reviewed.

# ---- logs / debug ----
*.log
npm-debug.log*

# ---- environment variables & other secrets ----
# Real credentials (DB URLs, Better Auth secret, Stripe/Resend/S3 keys) live in
# these and must never be committed. `.env.example` is the exception: it documents
# every variable a dev needs with placeholder values only, so it's meant to be
# shared and tracked.
.env
.env.local
.env.*.local
!.env.example

# ---- OS-generated files ----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

# ---- editor / IDE local state ----
# Personal editor config, not team config. If you want to share recommended
# extensions or debug configs later, add explicit `!.vscode/<file>` exceptions.
.vscode/*
.idea/
*.swp
*.swo
*~

# ---- deployment / tooling local links ----
# Both are CLI-generated local links to a hosted project (Vercel / Neon), not
# portable source — re-created per machine by `vercel link` / `neonctl` login.
.vercel
.neon

# ---- Claude Code local settings ----
# Personal permission/model overrides for this machine; `.claude/settings.json`
# (team-shared config, if added) stays tracked.
.claude/settings.local.json
